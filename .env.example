# Safety: keep true until the observed signals and simulated orders look right.
DRY_RUN=true

# Wallets to follow. Add more addresses separated by commas.
SMART_WALLETS=7yd579zXmWPoxEE22BUYTzAo8nyMmQtPyEWS3g1BFhH4

# Silicon Valley deployment: race the two nearest US-West LaserStream regions.
HELIUS_LASERSTREAM_ENDPOINTS=https://laserstream-mainnet-lax.helius-rpc.com,https://laserstream-mainnet-slc.helius-rpc.com
HELIUS_LASERSTREAM_TOKEN=

# Read RPC and optional staked transaction RPC.
HELIUS_RPC_URL=
HELIUS_STAKED_RPC_URL=

# Closest documented backend Sender region for a Silicon Valley server.
HELIUS_SENDER_ENDPOINTS=http://slc-sender.helius-rpc.com/fast
# Keep the Sender connection warm; 5000 ms follows Helius guidance.
SENDER_WARM_INTERVAL_MS=5000

# Required only when DRY_RUN=false. Base58 secret key; never commit this value.
WALLET_PRIVATE_KEY_BS58=

# BUY sizing: FIXED uses FOLLOW_BUY_SOL for every smart-wallet buy.
# PROPORTIONAL uses detected smart-wallet SOL spend * FOLLOW_BUY_SCALE, capped below.
FOLLOW_BUY_MODE=FIXED
FOLLOW_BUY_SOL=0.05
FOLLOW_BUY_SCALE=0.10
FOLLOW_MIN_BUY_SOL=0.02
FOLLOW_MAX_BUY_SOL=0.30
FOLLOW_MIN_SMART_BUY_SOL=0

# SELL sizing: FULL exits our whole source-wallet lot on the first detected sell.
# PROPORTIONAL remains available if partial mirrored exits are needed later.
FOLLOW_SELL_MODE=FULL

# Risk/duplication controls.
FOLLOW_MAX_SIGNAL_AGE_MS=5000
FOLLOW_MAX_OPEN_POSITIONS=20
FOLLOW_MAX_TOTAL_SOL=2
FOLLOW_ALLOW_SCALE_IN=true
FOLLOW_MAX_BUYS_PER_WALLET_MINT=5

# Execution protection. 3000 bps = 30% maximum slippage for volatile copy trades.
BUY_SLIPPAGE_BPS=3000
SELL_SLIPPAGE_BPS=3000
COMPUTE_UNIT_LIMIT=250000
BUY_PRIORITY_FEE_LAMPORTS=500000
SELL_PRIORITY_FEE_LAMPORTS=200000

# A submitted trade is recorded as a position only after confirmed succeeds.
TX_CONFIRMATION_TIMEOUT_MS=20000
TX_CONFIRMATION_POLL_MS=500

# Retry exactly once only after an explicitly confirmed Pump Curve Custom:6002.
# Timeouts and unknown submission states are never retried to avoid duplicate buys.
CURVE_BUY_RETRY_6002=true
CURVE_BUY_RETRY_MAX_SIGNAL_AGE_MS=5000

# Trailing take profit: activate at +80%, then sell the whole position after a 15% drawdown.
TRAILING_TAKE_PROFIT_ENABLED=true
TRAILING_TAKE_PROFIT_ACTIVATION_PERCENT=80
TRAILING_TAKE_PROFIT_DRAWDOWN_PERCENT=15
TRAILING_TAKE_PROFIT_POLL_MS=1000
TRAILING_TAKE_PROFIT_RETRY_MS=5000

# Sender routing requires a Helius-compatible tip when endpoints are configured.
# Set 0 to disable Sender and use only the staked/read RPC submission path.
JITO_TIP_LAMPORTS=1000000

# Local state and audit trail, relative to smart-wallet-bot/.
STATE_FILE=./data/state.json
AUDIT_FILE=./data/trades.jsonl

# Local dashboard. Keep loopback-only and use an SSH tunnel for remote access.
DASHBOARD_ENABLED=true
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8787
DASHBOARD_TOKEN=
DASHBOARD_RECENT_TRADES=100
